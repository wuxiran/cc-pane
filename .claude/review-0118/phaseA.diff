+///
+/// 返回 `None` = 不换（已是最新 / 有活跃会话 / 读不到时间戳）。
+fn pending_daemon_upgrade(daemon_binary: &Path, client: &TerminalDaemonClient) -> Option<String> {
+    let status = client.status().ok()?;
+    let binary_mtime_ms = daemon_binary
+        .metadata()
+        .ok()?
+        .modified()
+        .ok()?
+        .duration_since(std::time::UNIX_EPOCH)
+        .ok()?
