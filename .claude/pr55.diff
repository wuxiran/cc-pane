+const IMAGE_EXTENSIONS = new Set(["png", "jpg", "jpeg", "gif", "webp", "bmp", "ico"]);
+
+export function isImageFile(filePath: string): boolean {
+  const extension = filePath.split(".").pop()?.toLowerCase() ?? "";
