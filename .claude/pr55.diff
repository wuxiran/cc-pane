+        assert!(path_is_within(
+            Path::new("\\\\wsl.localhost\\Ubuntu\\home\\dev\\repo\\src\\main.rs"),
+            root,
+        ));
+        assert!(!path_is_within(
+            Path::new("\\\\wsl.localhost\\Ubuntu\\home\\dev\\repo-other\\main.rs"),
+            root,
+        ));
+    }
