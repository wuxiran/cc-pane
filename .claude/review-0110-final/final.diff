+            date: usage_date(json),
+            token_input: input.unwrap_or(0),
+            token_output: output.unwrap_or(0),
+            token_cache_read: cache_read_tokens(usage),
+            token_cache_creation: number_field(usage, &["cache_creation_input_tokens"]),
+        },
