+) -> Result<(Option<LatestContextUsage>, u64), String> {
+    let file = File::open(jsonl_path).map_err(|error| error.to_string())?;
+    let len = file.metadata().map_err(|error| error.to_string())?.len();
+    if len > MAX_CONTEXT_USAGE_FILE_BYTES {
