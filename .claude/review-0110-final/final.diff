++pub fn managed_provider_conflict_env_keys(cli_tool: CliTool) -> &'static [&'static str] {
++    match cli_tool {
++        CliTool::Claude => &[
++            "ANTHROPIC_API_KEY",
++            "ANTHROPIC_AUTH_TOKEN",
++            "ANTHROPIC_BASE_URL",
++            "CLAUDE_CODE_USE_BEDROCK",
++            "CLAUDE_CODE_USE_VERTEX",
++            "AWS_REGION",
++            "AWS_PROFILE",
++            "CLOUD_ML_REGION",
++            "ANTHROPIC_VERTEX_PROJECT_ID",
++            "CLAUDE_CONFIG_DIR",
++        ],
++        CliTool::Codex => &[
++            "CODEX_API_KEY",
++            "OPENAI_API_KEY",
++            "OPENAI_BASE_URL",
++            "CCPANES_CODEX_API_KEY",
++        ],
++        CliTool::Gemini => &["GEMINI_API_KEY", "GOOGLE_API_KEY", "GEMINI_API_BASE"],
++        CliTool::Kimi => &["KIMI_API_KEY", "KIMI_BASE_URL", "KIMI_SHARE_DIR"],
++        CliTool::Glm => &[
++            "ZAI_API_KEY",
++            "ZAI_BASE_URL",
++            "CRUSH_GLOBAL_CONFIG",
++            "CRUSH_GLOBAL_DATA",
++        ],
++        CliTool::Opencode => &[
++            "OPENAI_API_KEY",
++            "OPENAI_BASE_URL",
++            "ANTHROPIC_API_KEY",
++            "ANTHROPIC_BASE_URL",
++            "OPENCODE_CONFIG",
++        ],
++        CliTool::Cursor => &["CURSOR_API_KEY"],
++        CliTool::Grok => &[
++            "XAI_API_KEY",
++            "XAI_BASE_URL",
++            "GROK_MODELS_BASE_URL",
++            "GROK_CLI_CHAT_PROXY_BASE_URL",
++        ],
++        CliTool::None => &[],
++    }
++}
