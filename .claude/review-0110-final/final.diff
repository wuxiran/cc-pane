+        .map_err(|error| error.to_string())?;
+    let mut reader = BufReader::new(file);
+    let mut offset = start;
+    let mut latest: Option<LatestContextUsage> = None;
+    let mut lines_read = 0usize;
+
+    loop {
+        if lines_read >= MAX_CONTEXT_USAGE_LINES {
+            break;
