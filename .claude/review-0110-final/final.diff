+        let metadata = match fs::metadata(path) {
+            Ok(metadata) => metadata,
+            Err(error) => {
+                warn!(path = %path.display(), err = %error, "Failed to read context usage metadata");
+                return ContextUsageSnapshot::error("SOURCE_UNAVAILABLE", observed_at);
+            }
