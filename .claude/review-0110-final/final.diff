++fn valid_wsl_distro(value: &str) -> bool {
++    !value.is_empty()
++        && value.len() <= 64
++        && value
++            .bytes()
++            .all(|byte| byte.is_ascii_alphanumeric() || matches!(byte, b'-' | b'_' | b'.'))
++}
