++fn sibling_temp_path(path: &Path) -> PathBuf {
++    let mut name = path
++        .file_name()
++        .unwrap_or_else(|| OsStr::new("cc-panes"))
++        .to_os_string();
++    name.push(format!(
++        ".tmp-{}-{}",
++        std::process::id(),
++        std::time::SystemTime::now()
++            .duration_since(std::time::UNIX_EPOCH)
++            .map(|duration| duration.as_nanos())
++            .unwrap_or_default()
++    ));
++    path.with_file_name(name)
